# Copiar a .env y ajustar. Si no existe .env se usan estos mismos valores por defecto.

DB_USER=postgres
DB_PASSWORD=1234
DB_HOST=localhost
DB_PORT=5432
DB_NAME=DepositoEmmanuel

# Alternativamente, una sola URL (tiene prioridad sobre lo anterior):
# DATABASE_URL=postgresql+psycopg://postgres:1234@localhost:5432/DepositoEmmanuel

# Poner en true para ver el SQL generado en consola
SQL_ECHO=false

# Clave para firmar la cookie de sesión. Cambiar en producción.
SECRET_KEY=dev-only-change-me-Emmanuel100200
